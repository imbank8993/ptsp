PORT=3007
NODE_ENV=development

# Database acca_db (PostgreSQL VPS)
DATABASE_URL=postgresql://postgres:password@host:5432/acca_db?schema=public

# Cloudflare R2 Object Storage
R2_ACCOUNT_ID=your_cloudflare_r2_account_id
R2_ACCESS_KEY_ID=your_cloudflare_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_access_key
R2_BUCKET=acca
R2_PUBLIC_BASE_URL=https://your-r2-worker.workers.dev
R2_PTSP_FOLDER=PTSP

# Allowed Origins for CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,https://ptsp.icgowa.sch.id

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=60
